DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/elysia_tanstart

# docker-compose.yml uses the host network and this DATABASE_URL.
# APP_PORT=3000
#
# docker-compose-with-postgres.yml starts its own Postgres:
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=elysia_tanstart
# DB_PORT=5432

PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=mt1
PUSHER_HOST=soketi.domain.com
PUSHER_PORT=443
PUSHER_FORCE_TLS=true

VITE_PUSHER_APP_ID=
VITE_PUSHER_APP_KEY=
VITE_PUSHER_CLUSTER=mt1
VITE_PUSHER_HOST=soketi.domain.com
VITE_PUSHER_PORT=443
VITE_PUSHER_FORCE_TLS=true
